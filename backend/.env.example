PORT=5001
NODE_ENV=production

# Database (MariaDB 10.4+ / MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=your_random_long_secret_key

# Telegram Bot (Can also be configured dynamically from the Web UI)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_CHAT_ID=your_numeric_chat_id

REMINDER_TIERS=30,15,7,3,1,0
CRON_SCHEDULE="0 9 * * *"
