# ==============================================================================
# RenewRadar - Environment Configuration Template
# All values below are placeholders. Copy this file to .env and supply your credentials.
# ==============================================================================

# Application Port for Node.js Express API server
PORT=5001

# Application Environment ('development' or 'production')
NODE_ENV=production

# MariaDB / MySQL Database Host (e.g., localhost, 127.0.0.1, or remote host)
DB_HOST=localhost

# MariaDB / MySQL Database Port (Default: 3306)
DB_PORT=3306

# MariaDB / MySQL Database Username with access to RenewRadar database
DB_USER=your_db_user

# MariaDB / MySQL Database User Password
DB_PASSWORD=your_db_password

# MariaDB / MySQL Database Name
DB_NAME=your_db_name

# MariaDB Root User Password (used for containerized setup in Docker)
DB_ROOT_PASSWORD=your_db_root_password

# Default Administrator Username for initial dashboard login
ADMIN_USERNAME=admin

# Default Administrator Password for initial dashboard login
ADMIN_PASSWORD=your_secure_password

# Secret key used for signing and verifying JWT authentication tokens.
# Generate a random 32-byte hexadecimal key using: openssl rand -hex 32
JWT_SECRET=your_random_long_secret_key_change_me_in_production

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Numeric Chat ID of Admin to receive automated expiry notifications
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# Cron schedule expression for automated daily expiry notification checks (e.g., '0 9 * * *' = 9:00 AM daily)
ALERT_CRON="0 9 * * *"

# Days prior to expiry when alerts should trigger (comma-separated tiers)
ALERT_TIERS=30,15,7,3,1,0
